# Servizio systemd per avviare Patente Quiz all'accensione del Raspberry.
#
#   sudo cp deploy/patente-quiz.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/patente-quiz.service    # adatta User e percorsi
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now patente-quiz
#   journalctl -u patente-quiz -f                         # log
#
# La password si legge dal file .env nella cartella del progetto.

[Unit]
Description=Patente Quiz
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/patente-quiz
ExecStart=/home/pi/patente-quiz/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
