# Copia questo file in ".env" e modificalo.

# OBBLIGATORIA: password per entrare nell'app (almeno 4 caratteri, meglio una lunga).
PATENTE_PASSWORD=cambia-questa-password

# --- Facoltative -------------------------------------------------------------
# PORT=8000                  # porta sul Raspberry
# TZ=Europe/Rome             # fuso orario (per le statistiche giornaliere)

# Esposizione di rete. Scegli in base a come vuoi raggiungere l'app (vedi README):
#   Solo rete locale (default):    BIND=0.0.0.0
#   Tailscale / Caddy / Cloudflare: BIND=127.0.0.1  e  FORWARDED_ALLOW_IPS=*
# BIND=0.0.0.0
# FORWARDED_ALLOW_IPS=127.0.0.1

# Solo per deploy/compose.caddy.yml
# DOMAIN=patente.example.com
# Solo per deploy/compose.cloudflared.yml
# TUNNEL_TOKEN=
